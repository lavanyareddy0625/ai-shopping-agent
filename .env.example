# Set ONE of these (free keys: https://console.groq.com/keys , https://aistudio.google.com/apikey)
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional overrides
# LLM_PROVIDER=groq            # groq | gemini (auto-detected from whichever key is set)
# LLM_MODEL=llama-3.3-70b-versatile   # gemini default: gemini-3.8-flash
# SEARCH_REGION=in-en          # DuckDuckGo region, e.g. us-en, uk-en, wt-wt
# DB_PATH=data/shopping.db
# RATE_LIMIT_SEARCHES=6          # new searches per IP per window
# RATE_LIMIT_WINDOW_SECONDS=600
# MAX_CONCURRENT_SEARCHES=3      # agent runs at the same time
# RESULT_CACHE_TTL=21600         # seconds an identical finished search is replayed
# SEARCH_CACHE_TTL=21600         # seconds web search / page fetches are cached
